{
  "name": "anceryx",
  "version": "0.15.1",
  "license": "Apache-2.0",
  "author": "Anceryx",
  "description": "Plataforma social Anceryx",
  "main": "out/main/main.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/generate-license-assets.mjs",
    "dev:web": "vite --config vite.web.config.ts",
    "build:web": "vite build --config vite.web.config.ts && node scripts/prepare-web-output.mjs && node scripts/web-build-smoke.mjs",
    "preview:web": "vite preview --config vite.web.config.ts",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "test:web-routing": "node --experimental-strip-types scripts/web-routing.test.mjs",
    "audit:licenses": "node scripts/audit-licenses.mjs",
    "test:license-audit": "node --test scripts/license-audit.test.mjs",
    "preview": "electron-vite preview",
    "electron:dev": "electron-vite dev",
    "electron:build": "npm run build && electron-builder --publish never",
    "test:update-security": "node --experimental-strip-types scripts/update-security-smoke.mjs",
    "test:connection-config": "node --experimental-strip-types scripts/connection-config-smoke.mjs",
    "test:api-config": "node --experimental-strip-types scripts/api-config.test.mjs",
    "test:electron-safe-storage": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/electron-safe-storage-two-process-smoke.ps1",
    "test:encrypted-drafts": "node --experimental-strip-types scripts/encrypted-drafts.test.mjs",
    "test:session-revision": "node --experimental-strip-types scripts/session-revision.test.mjs",
    "test:image-crop": "node --experimental-strip-types scripts/image-crop.test.mjs",
    "test:image-crop:visual": "vite --config scripts/image-crop-visual-vite.config.ts",
    "test:shared-post-link": "node --experimental-strip-types scripts/shared-post-link.test.mjs",
    "test:explore-discovery": "node scripts/explore-discovery.test.mjs",
    "test:forum-list-compatibility": "node --experimental-strip-types scripts/forum-list-compatibility.test.mjs",
    "test:app-deep-link": "node --experimental-strip-types scripts/deep-link.test.mjs",
    "test:ipc-security": "node --experimental-strip-types scripts/ipc-security.test.mjs",
    "test:dialog-accessibility": "node --experimental-strip-types scripts/dialog-accessibility.test.mjs",
    "test:theme-entitlement": "node --experimental-strip-types scripts/theme-entitlement.test.mjs",
    "test:community-member-groups": "node --experimental-strip-types scripts/community-member-groups.test.mjs",
    "test:community-voice-realtime": "node --experimental-strip-types scripts/community-voice-realtime.test.mjs",
    "test:realtime-transport": "node --experimental-strip-types scripts/realtime-transport.test.mjs",
    "test:direct-message-cache": "node --experimental-strip-types scripts/direct-message-cache.test.mjs",
    "test:conversation-drafts": "node --experimental-strip-types scripts/conversation-drafts.test.mjs",
    "test:community-moderation-permissions": "node --experimental-strip-types scripts/community-moderation-permissions.test.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test:encoding": "node scripts/check-text-encoding.mjs",
    "test:date-format-preferences": "node --experimental-strip-types scripts/date-format-preferences.test.mjs",
    "test:i18n-catalog": "node --experimental-strip-types scripts/i18n-catalog.test.mjs",
    "test:i18n-large-modules": "node --experimental-strip-types scripts/i18n-large-modules.test.mjs",
    "test:i18n-global-ui": "node --experimental-strip-types scripts/i18n-global-ui.test.mjs",
    "i18n:coverage": "node scripts/i18n-coverage.mjs",
    "i18n:coverage:write": "node scripts/i18n-coverage.mjs --write",
    "test:keyboard-shortcuts": "node --experimental-strip-types scripts/keyboard-shortcuts.test.mjs",
    "test:community-permissions": "node --experimental-strip-types scripts/community-permissions.test.mjs",
    "test:community-posts": "node scripts/community-posts.test.mjs",
    "test:community-workspace-layout": "node --experimental-strip-types scripts/community-workspace-layout.test.mjs",
    "test:community-screen-share": "node scripts/community-screen-share.test.mjs",
    "test:settings-license-ui": "node scripts/settings-license-ui.test.mjs",
    "test:updater-ui-state": "node scripts/updater-ui-state.test.mjs",
    "test:mp4-diagnostics": "node scripts/mp4-playback-diagnostics.test.mjs",
    "test:media-utils": "node --experimental-strip-types scripts/media-utils.test.mjs",
    "test:renderer-url-guard": "node scripts/renderer-url-guard.test.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "lucide-react": "^0.414.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.14.11",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.3",
    "vite": "^7.3.7"
  }
}
